# ---------- Zetaris (AWS Managed Cluster / EC2) ----------
# Replace with your AWS cluster endpoint or EC2 Public IP/DNS.
# Examples:
#   http://<ec2-public-ip>:8888/api/v1.0
#   https://<cluster-name>.<region>.zetaris.com:8888/api/v1.0
#   https://<workspace>.cloud.enterprise.zetaris.com/api/v1.0
ZETARIS_REST_URL=http://localhost:8888/api/v1.0

# On AWS/Cloud, find your numeric Org ID in the Zetaris Web UI (Management / Profile). Default is often 1.
ZETARIS_ORG_ID=1

# Created in your AWS Zetaris Web UI (http://<ec2-ip>:3000): Management -> API Tokens.
# Never ask an agent to create these.
ZETARIS_BUILDER_API_KEY=your-zetaris-builder-token
ZETARIS_READER_API_KEY=

# Required form: app_name user@domain.tld (mandatory contact email to avoid strict 5 req/min rate limit)
ZETARIS_USER_AGENT=pipeless you@example.com
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TIMEOUT_SECONDS=180

# Local clone of https://github.com/zetaris/getting-started (recipes are read from here)
ZETARIS_REPO_PATH=../getting-started

# ---------- Meterless Nightshift (primary AI provider) ----------
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_NAME=pipeless
# Pin real model ids discovered via GET /v1/models (see scripts/check_nightshift.py)
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# ---------- Pipeless runtime ----------
PIPELESS_API_TOKEN=choose-a-long-random-string
APPROVAL_MODE=auto_policy        # auto_policy | manual
MAX_REVISIONS=2
MAX_LLM_CALLS_PER_RUN=40
SAMPLE_MODE=false
LOG_DIR=logs
DATA_DIR=data
